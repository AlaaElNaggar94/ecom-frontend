{
  "name": "ecom-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    
    "start:dev": "ng serve --configuration development -o",
    "start:test": "ng serve --configuration test -o",
    "start:prod": "ng serve --configuration production -o",

    "build": "ng build",
    "build:test": "ng build --configuration test",
    "build:prod": "ng build --configuration production",

    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ecom-frontend": "node dist/ecom-frontend/server/server.mjs",
    "generate:api:dev": "openapi-generator-cli generate -i http://localhost:4321/swagger/v1/swagger.json -g typescript-angular -o src/app/core/api",
    "generate:api:test": "openapi-generator-cli generate -i http://localhost:3366/swagger/v1/swagger.json -g typescript-angular -o src/app/core/api"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.17",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "express": "^4.18.2",
    "material-icons": "^1.13.14",
    "ngx-bootstrap": "^12.0.0",
    "ngx-image-zoom": "^3.0.0",
    "ngx-spinner": "^17.0.0",
    "ngx-toastr": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^9.0.1",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@openapitools/openapi-generator-cli": "^2.35.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/uuid": "^9.0.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}